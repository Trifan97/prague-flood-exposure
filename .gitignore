# Virtual environment and project-local tools (the portable JDK)
.venv/
.tools/

# Python caches and build artefacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Spark leaves these behind when run locally (.spark/ holds its jar cache and scratch files)
.spark/
# DuckDB's extensions
.duckdb/
spark-warehouse/
metastore_db/
derby.log
*.crc

# Data: every input is downloaded by the pipeline and pinned by SHA-256 in config.py,
# and every output is re-created, so none of it is committed.
data/

# OS and editor noise
.DS_Store
._*
Thumbs.db
.vscode/
.idea/
